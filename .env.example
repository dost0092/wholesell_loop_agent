# =============================================================================
# TX/FL Distressed Property Lead-Gen System — environment variables
# Copy to .env and fill in values. Never commit .env.
# =============================================================================

# --- App ---
APP_ENV=development
SECRET_KEY=change-me-to-a-long-random-string
API_KEY=
REQUIRE_HUMAN_APPROVAL=true
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
RATE_LIMIT_PER_MINUTE=60

# --- Database ---
# Local dev (no Docker): SQLite — works out of the box
DATABASE_URL=sqlite:///./data/leadgen.db
# Production / Docker: Postgres + PostGIS
# DATABASE_URL=postgresql+psycopg://leadgen:leadgen@localhost:5432/leadgen

# --- LLM (Claude) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

# --- Email send (your own SMTP — Gmail App Password to start) ---
# NOTE: Personal Gmail has ~500/day limits and weak domain reputation.
# A purchased domain with SPF/DKIM/DMARC would perform much better.
# Provider: console | smtp | gmail_api
EMAIL_PROVIDER=console
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM_NAME=Your Name
SMTP_FROM_EMAIL=your.email@gmail.com
SMTP_USE_TLS=true
SMTP_DAILY_LIMIT=25
SMTP_SEND_DELAY_MIN_SEC=30
SMTP_SEND_DELAY_MAX_SEC=120

# --- Gmail API (OAuth 2.0) — recommended for production automated sending ---
# Create credentials at https://console.cloud.google.com/apis/credentials
# Enable the Gmail API, create an OAuth 2.0 Desktop client, then run:
#   cd backend && python -m scripts.gmail_authorize
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
SENDER_EMAIL=your.email@gmail.com
EMAIL_SENDER_NAME=Your Name

# --- Daily email scheduler (10 personalized emails/day) ---
EMAIL_SCHEDULER_ENABLED=false
EMAIL_TIMEZONE=America/Chicago
EMAILS_PER_DAY=10
EMAIL_START_TIME=09:00
EMAIL_END_TIME=18:00
EMAIL_INTERVAL_MINUTES=60
EMAIL_JITTER_MIN_MINUTES=5
EMAIL_JITTER_MAX_MINUTES=10
EMAIL_MAX_RETRIES=5
EMAIL_RETRY_BASE_SECONDS=60

# Physical address required for CAN-SPAM footer
CANSPAM_PHYSICAL_ADDRESS=123 Main St, Houston, TX 77002

# --- Email receive (IMAP — same Gmail App Password) ---
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your.email@gmail.com
IMAP_PASSWORD=your-gmail-app-password

# --- SMS (Twilio — swappable adapter) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Skip trace (swappable adapter — change provider via env, no code changes) ---
# Recommended starter: BatchData (batchdata.com) — pay-per-hit with trial credits.
# Alternatives: Tracerfy, Skip Sherpa — set provider name and API key below.
SKIP_TRACE_PROVIDER=batchdata
SKIP_TRACE_API_KEY=
SKIP_TRACE_API_URL=https://api.batchdata.com/api/v1/property/skip-trace

# --- Entity lookups (free tiers) ---
OPENCORPORATES_API_KEY=
# TX Comptroller + FL Sunbiz are public web lookups (no key required)

# --- Pipeline config ---
TOP_N_PER_STATE=10
TARGET_STATES=TX,FL
# Counties (comma-separated) — defaults match your confirmed selection
TX_COUNTIES=Harris,Dallas,Tarrant
FL_COUNTIES=Miami-Dade,Broward,Hillsborough

# --- Scheduler ---
SCHEDULER_ENABLED=false
SCHEDULER_CRON_HOUR=7
SCHEDULER_CRON_MINUTE=0
SCHEDULER_TIMEZONE=America/Chicago
